import express from "express";
import cors from "cors";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { randomUUID } from "node:crypto";
import { mkdir, readFile, writeFile, rename, rm } from "node:fs/promises";

import routes from "./routes/index.js";
import "./cron/syncMRH.job.js"; // inicia cron
import "./cron/syncRondasCorpJob.js";

const app = express();

/* =========================================================
   CORS E JSON — CONFIGURACAO ORIGINAL
   ========================================================= */
app.use(
  cors({
    origin: "*",
    exposedHeaders: ["Authorization", "Content-Disposition"],
  }),
);

app.use(express.json());

app.use((err, req, res, next) => {
  const methodsWithBody = ["POST", "PUT", "PATCH"];

  if (
    methodsWithBody.includes(req.method) &&
    err instanceof SyntaxError &&
    err.status === 400 &&
    "body" in err
  ) {
    return res.status(400).json({
      sucesso: false,
      mensagem: "JSON inválido: verifique a sintaxe.",
    });
  }

  next(err);
});

const uploadsPath = path.resolve("uploads");
app.use("/uploads", express.static(uploadsPath));

/* =========================================================
   SEMANA DA QUALIDADE — MELHORIAS

   Tudo fica neste app.js. O arquivo de dados e criado
   automaticamente em: <raiz do backend>/data/melhorias.json

   Se o servidor usar um volume persistente, configure:
   MELHORIAS_DATA_DIR=/caminho/do/volume
   ========================================================= */

const appDir = path.dirname(fileURLToPath(import.meta.url));
const melhoriasDir = process.env.MELHORIAS_DATA_DIR
  ? path.resolve(process.env.MELHORIAS_DATA_DIR)
  : path.resolve(appDir, "../data");
const melhoriasFile = path.join(melhoriasDir, "melhorias.json");

// Mantem os salvamentos em fila para evitar perda de registros
// quando varios usuarios enviam ao mesmo tempo neste processo.
let filaMelhorias = Promise.resolve();

async function carregarMelhorias() {
  try {
    const conteudo = await readFile(melhoriasFile, "utf8");
    const melhorias = JSON.parse(conteudo);

    if (!Array.isArray(melhorias)) {
      throw new Error("O arquivo melhorias.json deve conter um array.");
    }

    return melhorias;
  } catch (err) {
    if (err.code === "ENOENT") return [];
    throw err;
  }
}

function registrarMelhoria(melhoria) {
  const operacao = filaMelhorias.then(async () => {
    await mkdir(melhoriasDir, { recursive: true });

    const melhorias = await carregarMelhorias();
    melhorias.push(melhoria);

    // Salva primeiro em arquivo temporario, depois substitui o JSON.
    const temporario = `${melhoriasFile}.${randomUUID()}.tmp`;
    try {
      await writeFile(temporario, JSON.stringify(melhorias, null, 2) + "\n", {
        encoding: "utf8",
        flag: "wx",
      });
      await rename(temporario, melhoriasFile);
    } catch (err) {
      await rm(temporario, { force: true }).catch(() => {});
      throw err;
    }
  });

  // Uma falha nao deve bloquear as proximas tentativas.
  filaMelhorias = operacao.catch(() => {});
  return operacao;
}

const textoValido = (valor, maximo, obrigatorio = true) =>
  typeof valor === "string" &&
  valor.trim().length <= maximo &&
  (!obrigatorio || valor.trim().length > 0);

app.post("/api/melhorias", async (req, res) => {
  const { area, title, desc, impact, effort, name = "" } = req.body || {};
  const niveis = ["Baixo", "Médio", "Alto"];

  if (
    !textoValido(area, 40) ||
    !textoValido(title, 80) ||
    !textoValido(desc, 400) ||
    !textoValido(name, 40, false) ||
    !niveis.includes(impact) ||
    !niveis.includes(effort)
  ) {
    return res.status(400).json({
      sucesso: false,
      mensagem: "Dados inválidos. Confira os campos da melhoria.",
    });
  }

  const melhoria = {
    id: randomUUID(),
    enviado_em: new Date().toISOString(),
    name: name.trim() || "Anônimo",
    area: area.trim(),
    title: title.trim(),
    desc: desc.trim(),
    impact,
    effort,
  };

  try {
    await registrarMelhoria(melhoria);
    return res.status(201).json({
      sucesso: true,
      mensagem: "Melhoria armazenada com sucesso.",
      id: melhoria.id,
    });
  } catch (err) {
    console.error("[MELHORIAS] Erro ao salvar JSON:", err);
    return res.status(500).json({
      sucesso: false,
      mensagem: "Não foi possível salvar a melhoria.",
    });
  }
});

